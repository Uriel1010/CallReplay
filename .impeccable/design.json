  "narrative": {
    "northStar": "The approved lavender reference",
    "overview": "The user-supplied twelve-screen reference dated 2026-11-04 governs the visual direction. Native Jetpack Compose and Material 3 provide structure and interaction; lavender surfaces, purple controls and rounded recording rows carry the identity. This records the implemented system, including its separate dark scheme.\n\nThe library is compact and readable. Task pages retain a shared top app bar, settings use bordered rows, and the player centers the waveform identity above playback controls. Product behavior and privacy commitments remain in PRODUCT.md.",
    "keyCharacteristics": [
      "Lavender tonal surfaces with purple primary actions.",
      "Rounded bordered cards and native Material controls.",
      "Hebrew and English text with explicit numeric reading direction.",
      "Theme-specific blue incoming and green outgoing indicators."
    ],
    "rules": [
      {
        "name": "The Fixed Palette Rule",
        "body": "Resolve colors through the active Material scheme; the implemented brand palette remains fixed rather than wallpaper-derived.",
        "section": "colors"
      },
      {
        "name": "The Direction Rule",
        "body": "Incoming arrows are blue and outgoing arrows use tertiary green; their physical arrow direction remains stable in RTL.",
        "section": "colors"
      },
      {
        "name": "The Reading Direction Rule",
        "body": "Follow locale for content layout while preserving LTR phone numbers, filenames, playback times and seeking; English legal content uses an LTR region.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do resolve surfaces and text through the active light or dark Material roles.",
      "Do preserve blue incoming, green outgoing and fixed physical direction arrows.",
      "Do retain native Material interactions, accessibility labels, insets and system font scaling.",
      "Do use the implemented navigation rail breakpoint when extending wider layouts."
    ],
    "donts": [
      "Don't mirror phone numbers, filenames, playback times or English legal paragraphs with Hebrew layout.",
      "Don't replace the approved fixed palette with wallpaper-derived dynamic color.",
      "Don't treat generated sidecar previews or tonal ramps as device screenshots or new application tokens."
